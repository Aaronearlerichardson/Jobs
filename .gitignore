cro_names.txt
local_tech_companies.txt

# Nuitka build outputs (build_exe.bat)
webapp.build/
webapp.dist/
webapp.onefile-build/

# Python cruft
__pycache__/
*.pyc
*.pyo
.venv/
venv/

# Editor
.idea/
.vscode/
.claude/
*.swp
.DS_Store
*.bak

# Personal search profile (keywords/locations) — profile.example.toml is the template
profile.toml
# All local data: DBs, resume, job_reports/, captures/, caches, profile backups
data/

# DDG search cache (bounded web-search step)
.cache/
