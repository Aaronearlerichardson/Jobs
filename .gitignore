# Secrets — never commit
credentials.json
.env
*.env

# Playwright session state — contains auth cookies. NEVER commit.
sessions/

# Runtime data
*.db
job_reports/
*.log
~$*
captures/
# discovery run artifacts / harvested name lists
cro_names.txt
local_tech_companies.txt

# Nuitka build outputs (build_exe.bat)
webapp.build/
webapp.dist/
webapp.onefile-build/
JobCrawlerUI.exe
harvest.build/
harvest.dist/
harvest.onefile-build/
JobHarvester.exe
job-crawler-ui
job-crawler-linux
job-crawler-macos
# Nuitka's --report=, which CI uploads as an artifact and a local build
# writes into the checkout (*.report.xml is ~1 MB of module inventory).
*.report.xml

# Python cruft
__pycache__/
*.pyc
*.pyo
.venv/
venv/

# Editor
.idea/
.vscode/
.claude/
*.swp
.DS_Store
*.bak

# Personal search profile (keywords/locations) — profile.example.toml is the template
profile.toml
# All local data: DBs, resume, job_reports/, captures/, caches, profile backups
data/

# DDG search cache (bounded web-search step)
.cache/
.junie/
coverage.xml
.coverage
htmlcov/
boards_status.json
